# EnCodec 24k, atoms mode (comparator of the S3 speed test; warns: causal codec in atoms mode)
codec.name = "encodec24k"
generation.mode = "atoms"
atoms.seconds = 0.32
atoms.hop_seconds = 0.10
atoms.crossfade_seconds = 0.02
dataset.memory_buffer_atoms = 3
# training
training.standardize_latents = True
training.past_noise = 0.0
