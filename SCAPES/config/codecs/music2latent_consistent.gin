# Music2Latent, consistent atoms (docs/overlap_add.md): hop exactly 0.1 s (4410 samples, off the 4096 grid), equal-power
# crossfade of 3782 samples (85.8 ms, the whole overlap of 2-latent atoms; 0.08574 s since the loader rounds up), the same for
# every size so that they compare fairly (a later change is expected), the rest of the overlap zeroed; every segment is encoded
# on its own. atoms.seconds 0.18 / 0.37 / 0.55 / 0.74 give exactly 2 / 4 / 6 / 8 latents. Gate W and O4, 2026-10-30.
codec.name = "music2latent"
generation.mode = "atoms"
atoms.type = "consistent"
atoms.seconds = 0.37
atoms.hop_seconds = 0.10
atoms.crossfade_seconds = 0.08574
atoms.window = "equal_power"
dataset.memory_buffer_atoms = 3
training.standardize_latents = True
training.past_noise = 0.0
