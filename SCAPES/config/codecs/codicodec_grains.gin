# CoDiCodec as grains (stochastic decoder: see docs/overlap_add.md). The model generates one atom at a time and atoms do not
# share latent frames: an atom is whole chunks of 0.743 s (quantum 8 frames), here 1 chunk. The decoded atoms are overlapped in
# the audio only, by a fraction of the atom set by atoms.overlap_mode, with an equal-power crossfade. The output is that much
# shorter than the sum of the atoms, and the conditioning rate is the audio hop:
#   normal: overlap 50 ms,  hop 0.69 s     strong: overlap 25 % (0.19 s), hop 0.56 s     brute: overlap 50 % (0.37 s), hop 0.37 s
# The templates codicodec_atoms.gin (2-chunk atoms regenerating a chunk) is the geometry of the trained V2 models.
codec.name = "codicodec"
generation.mode = "atoms"
atoms.seconds = 0.74
atoms.overlap_mode = "strong"
dataset.memory_buffer_atoms = 1
# training
training.standardize_latents = True
training.past_noise = 0.0
