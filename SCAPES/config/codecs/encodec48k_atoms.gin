# EnCodec 48k, atoms mode (V1 geometry: 0.32 s atoms, 0.1 s hop, 3 past atoms)
codec.name = "encodec48k"
generation.mode = "atoms"
atoms.seconds = 0.32
atoms.hop_seconds = 0.10
atoms.crossfade_seconds = 0.02
dataset.memory_buffer_atoms = 3
# training
training.standardize_latents = False
training.past_noise = 0.0
